{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.17/analysis_input.schema.json",
  "title": "Canonical paired analysis input v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "raw_result_manifest_sha256",
    "analysis_builder_sha256",
    "raw_result_manifest_path",
    "selected_task_manifest_path",
    "selected_task_manifest_sha256",
    "expected_task_ids",
    "expected_task_count",
    "expected_task_set_sha256",
    "comparisons",
    "created_at",
    "analysis_input_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-analysis-input/1.2"
    },
    "run_id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "PLANNER",
        "STAGE1A",
        "STAGE1B"
      ]
    },
    "raw_result_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "comparisons": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/comparison"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "analysis_input_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "raw_result_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "analysis_builder_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "expected_task_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^bw-[0-9]{8}$"
      }
    },
    "expected_task_count": {
      "type": "integer",
      "minimum": 2
    },
    "expected_task_set_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "selected_task_manifest_path": {
      "type": "string",
      "pattern": "^sealed/[A-Za-z0-9._/-]+/selected-task-manifest\\.json$"
    },
    "selected_task_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "left",
        "right",
        "difference"
      ],
      "properties": {
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "difference": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "value"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "comparison": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_type",
            "complete_pair_count",
            "seed_groups"
          ],
          "properties": {
            "analysis_type": {
              "const": "PLANNER_HIERARCHICAL"
            },
            "complete_pair_count": {
              "type": "integer",
              "minimum": 2
            },
            "seed_groups": {
              "type": "object",
              "minProperties": 5,
              "additionalProperties": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/pair"
                }
              },
              "maxProperties": 5,
              "propertyNames": {
                "enum": [
                  "101",
                  "202",
                  "303",
                  "404",
                  "505"
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_type",
            "complete_pair_count",
            "task_clusters"
          ],
          "properties": {
            "analysis_type": {
              "const": "STAGE1A_CLUSTERED"
            },
            "complete_pair_count": {
              "type": "integer",
              "minimum": 2
            },
            "task_clusters": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/pair"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_type",
            "complete_pair_count",
            "pairs"
          ],
          "properties": {
            "analysis_type": {
              "const": "TASK_PAIRED"
            },
            "complete_pair_count": {
              "type": "integer",
              "minimum": 2
            },
            "pairs": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/pair"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_type",
            "complete_pair_count",
            "units"
          ],
          "properties": {
            "analysis_type": {
              "const": "SCALAR_RATE"
            },
            "complete_pair_count": {
              "type": "integer",
              "minimum": 2
            },
            "units": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        }
      ]
    }
  }
}
