{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.19/approved_freeze_pointer.schema.json",
  "title": "Approved confirmatory freeze pointer v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "freeze_id",
    "freeze_hash",
    "candidate_path",
    "candidate_sha256",
    "decision_record_path",
    "decision_record_sha256",
    "decision_id",
    "decision_hash",
    "approval_gate_id",
    "approved_at",
    "pointer_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-freeze/1.2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "stage": {
      "enum": [
        "PLANNER_CONFIRMATORY",
        "STAGE1A_CONFIRMATORY",
        "STAGE1B_CONFIRMATORY"
      ]
    },
    "freeze_id": {
      "type": "string",
      "pattern": "^freeze-[a-z0-9-]+$"
    },
    "freeze_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "candidate_path": {
      "type": "string",
      "pattern": "^freezes/[a-z0-9-]+\\.candidate\\.json$"
    },
    "candidate_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "decision_record_path": {
      "type": "string",
      "pattern": "^decisions/D-[0-9]{4}\\.json$"
    },
    "decision_record_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^D-[0-9]{4}$"
    },
    "decision_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "approval_gate_id": {
      "enum": [
        "G07_PLANNER_CONFIRMATORY_FREEZE",
        "G12_STAGE1A_CONFIRMATORY_FREEZE",
        "G16_STAGE1B_CONFIRMATORY_FREEZE"
      ]
    },
    "approved_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "pointer_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "PLANNER_CONFIRMATORY"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "approval_gate_id": {
            "const": "G07_PLANNER_CONFIRMATORY_FREEZE"
          },
          "candidate_path": {
            "const": "freezes/planner-confirmatory.candidate.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE1A_CONFIRMATORY"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "approval_gate_id": {
            "const": "G12_STAGE1A_CONFIRMATORY_FREEZE"
          },
          "candidate_path": {
            "const": "freezes/stage1a-confirmatory.candidate.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE1B_CONFIRMATORY"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "approval_gate_id": {
            "const": "G16_STAGE1B_CONFIRMATORY_FREEZE"
          },
          "candidate_path": {
            "const": "freezes/stage1b-confirmatory.candidate.json"
          }
        }
      }
    }
  ]
}
