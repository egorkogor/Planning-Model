{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.14/artifact_manifest.schema.json",
  "title": "Generic immutable artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "run_id",
    "artifact_type",
    "created_at",
    "source_hashes",
    "artifacts",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-manifest/1.0"
    },
    "manifest_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "manifest_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
