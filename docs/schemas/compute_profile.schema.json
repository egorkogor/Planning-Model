{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.13/compute_profile.schema.json",
  "title": "Compute profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "hardware",
    "variants",
    "equal_data_schedule",
    "flops_matched_schedule",
    "measurement_code_sha256",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-compute/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "hardware": {
      "type": "object"
    },
    "variants": {
      "type": "array",
      "minItems": 1
    },
    "equal_data_schedule": {
      "type": "object"
    },
    "flops_matched_schedule": {
      "type": "object"
    },
    "measurement_code_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
