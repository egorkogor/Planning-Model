{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.18/data_quality_report.schema.json",
  "title": "Data quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "report_type",
    "input_manifest_sha256",
    "checks",
    "summary",
    "status",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-data-quality/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "report_type": {
      "type": "string"
    },
    "input_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "checks": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
