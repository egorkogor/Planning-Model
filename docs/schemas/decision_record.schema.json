{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.18/decision_record.schema.json",
  "title": "Externally signed OperatorDecisionRecord v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "gate_id",
    "timestamp",
    "decision",
    "phase_outcome",
    "target_artifact_hash",
    "evidence_hashes",
    "operator_note",
    "resubmission_index",
    "previous_decision_hash",
    "decision_hash",
    "operator_key_id",
    "operator_public_key_sha256",
    "signature_algorithm",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-agent/1.3"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^D-[0-9]{4}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "gate_id": {
      "enum": [
        "G00_SCOPE",
        "G01_TRUST_AND_RESOURCES",
        "G06_STATISTICAL_IMPLEMENTATION_AUDIT",
        "G07_PLANNER_CONFIRMATORY_FREEZE",
        "G12_STAGE1A_CONFIRMATORY_FREEZE",
        "G16_STAGE1B_CONFIRMATORY_FREEZE",
        "G20_FINAL_ACCEPTANCE"
      ]
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "STOP"
      ]
    },
    "target_artifact_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "operator_note": {
      "type": "string"
    },
    "resubmission_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "decision_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "phase_outcome": {
      "enum": [
        "APPROVE_SCOPE",
        "REJECT_SCOPE",
        "APPROVE_TRUST_AND_RESOURCES",
        "REJECT_TRUST_AND_RESOURCES",
        "APPROVE_FREEZE",
        "REJECT_FREEZE",
        "APPROVE_FINAL",
        "REJECT_FINAL",
        "STOP",
        "APPROVE_G06_AUDITS",
        "REJECT_G06_AUDITS"
      ]
    },
    "operator_key_id": {
      "type": "string",
      "minLength": 1
    },
    "operator_public_key_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "previous_decision_hash": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G00_SCOPE"
          },
          "decision": {
            "const": "APPROVE"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "APPROVE_SCOPE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G00_SCOPE"
          },
          "decision": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "REJECT_SCOPE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G01_TRUST_AND_RESOURCES"
          },
          "decision": {
            "const": "APPROVE"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "APPROVE_TRUST_AND_RESOURCES"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G01_TRUST_AND_RESOURCES"
          },
          "decision": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "REJECT_TRUST_AND_RESOURCES"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "enum": [
              "G07_PLANNER_CONFIRMATORY_FREEZE",
              "G12_STAGE1A_CONFIRMATORY_FREEZE",
              "G16_STAGE1B_CONFIRMATORY_FREEZE"
            ]
          },
          "decision": {
            "const": "APPROVE"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "APPROVE_FREEZE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "enum": [
              "G07_PLANNER_CONFIRMATORY_FREEZE",
              "G12_STAGE1A_CONFIRMATORY_FREEZE",
              "G16_STAGE1B_CONFIRMATORY_FREEZE"
            ]
          },
          "decision": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "REJECT_FREEZE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G20_FINAL_ACCEPTANCE"
          },
          "decision": {
            "const": "APPROVE"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "APPROVE_FINAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G20_FINAL_ACCEPTANCE"
          },
          "decision": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "REJECT_FINAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G06_STATISTICAL_IMPLEMENTATION_AUDIT"
          },
          "decision": {
            "const": "APPROVE"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "APPROVE_G06_AUDITS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gate_id": {
            "const": "G06_STATISTICAL_IMPLEMENTATION_AUDIT"
          },
          "decision": {
            "const": "REJECT"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "REJECT_G06_AUDITS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "STOP"
          }
        }
      },
      "then": {
        "properties": {
          "phase_outcome": {
            "const": "STOP"
          }
        }
      }
    }
  ]
}
