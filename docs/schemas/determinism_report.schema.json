{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.15/determinism_report.schema.json",
  "title": "LLM determinism report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model_lock_sha256",
    "prompt_lock_sha256",
    "golden_prompt_count",
    "repetitions_per_prompt",
    "byte_identical_count",
    "parsed_identical_count",
    "status",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-determinism/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "model_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "prompt_lock_sha256": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "golden_prompt_count": {
      "type": "integer",
      "minimum": 1
    },
    "repetitions_per_prompt": {
      "type": "integer",
      "minimum": 20
    },
    "byte_identical_count": {
      "type": "integer",
      "minimum": 0
    },
    "parsed_identical_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
