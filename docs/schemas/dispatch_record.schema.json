{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.16/dispatch_record.schema.json",
  "title": "Role dispatch record v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "run_id",
    "dispatch_type",
    "stage",
    "source_role",
    "target_role",
    "input_hashes",
    "created_at",
    "status",
    "dispatch_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-agent/1.3"
    },
    "dispatch_id": {
      "pattern": "^DSP-[0-9]{4}$",
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "dispatch_type": {
      "enum": [
        "SEAL_DATASET",
        "RUN_CONFIRMATORY",
        "RUN_AUDIT"
      ]
    },
    "stage": {
      "enum": [
        "PLANNER",
        "STAGE1A",
        "STAGE1B",
        "FINAL_AUDIT"
      ]
    },
    "source_role": {
      "enum": [
        "BUILDER",
        "DATA_SEALER",
        "EVALUATION_RUNNER"
      ]
    },
    "target_role": {
      "enum": [
        "DATA_SEALER",
        "EVALUATION_RUNNER",
        "AUDIT_AGENT"
      ]
    },
    "input_hashes": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "PREPARED",
        "DISPATCHED",
        "ACKNOWLEDGED",
        "COMPLETED",
        "FAILED"
      ]
    },
    "dispatch_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "approved_freeze_pointer_path": {
      "type": "string",
      "pattern": "^freezes/(planner|stage1a|stage1b)-confirmatory\\.approved\\.json$"
    },
    "approved_freeze_pointer_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "approved_freeze_pointer_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "freeze_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dispatch_type": {
            "const": "RUN_CONFIRMATORY"
          }
        },
        "required": [
          "dispatch_type"
        ]
      },
      "then": {
        "required": [
          "approved_freeze_pointer_path",
          "approved_freeze_pointer_sha256",
          "approved_freeze_pointer_hash",
          "freeze_hash"
        ],
        "properties": {
          "source_role": {
            "const": "BUILDER"
          },
          "target_role": {
            "const": "EVALUATION_RUNNER"
          },
          "status": {
            "const": "DISPATCHED"
          }
        }
      }
    }
  ]
}
