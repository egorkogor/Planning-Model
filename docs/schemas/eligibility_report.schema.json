{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.17/eligibility_report.schema.json",
  "title": "Eligibility report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "eligible",
    "reasons",
    "source_decision_hash",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-eligibility/1.0"
    },
    "run_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "eligible": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_decision_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
