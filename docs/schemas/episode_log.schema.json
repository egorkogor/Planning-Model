{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.17/episode_log.schema.json",
  "title": "EpisodeLog v1.17",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "episode_id",
    "trajectory_id",
    "stage",
    "task_id",
    "snapshot_id",
    "canonical_task_hash",
    "split",
    "arm",
    "planner_seed",
    "rollout_mode",
    "goal_success",
    "progress_success",
    "steps_accepted",
    "attempts_total",
    "retries_total",
    "planner_calls",
    "oracle_length",
    "executed_length",
    "optimality_ratio",
    "semantic_resolver_calls",
    "semantic_unresolved_count",
    "unseen_support_signature_count",
    "terminal_error",
    "error_tags",
    "total_tokens_in",
    "total_attended_tokens",
    "total_tokens_out",
    "total_latency_ms",
    "final_state_hash",
    "pair_group_hash",
    "prompt_budget_violation_count",
    "contract_violation_count",
    "hash_violation_count",
    "base_task_id",
    "trajectory_policy",
    "experiment_freeze_hash",
    "episode_plan_manifest_hash",
    "plan_generation_status",
    "replay_context",
    "plan_positions_consumed",
    "plan_tokens_in_actual",
    "plan_tokens_out_actual",
    "plan_latency_ms_actual",
    "plan_tokens_in_attributed",
    "plan_tokens_out_attributed",
    "plan_latency_ms_attributed",
    "executor_tokens_in",
    "executor_tokens_out",
    "executor_latency_ms",
    "flops_actual",
    "flops_attributed",
    "flops_cap_per_task",
    "flops_budget_exhausted"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "$ref": "common.schema.json#/$defs/stage"
    },
    "task_id": {
      "type": "string",
      "pattern": "^bw-[0-9]{8}$"
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^snap-[0-9a-f]{16}$"
    },
    "canonical_task_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "split": {
      "$ref": "common.schema.json#/$defs/split"
    },
    "arm": {
      "$ref": "common.schema.json#/$defs/arm"
    },
    "planner_seed": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        101,
        202,
        303,
        404,
        505,
        null
      ],
      "description": "Final Planner checkpoint seed. Required even when plan generation fails; null only when no Planner checkpoint applies."
    },
    "rollout_mode": {
      "$ref": "common.schema.json#/$defs/rollout_mode"
    },
    "goal_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "progress_success": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "steps_accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "attempts_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 80
    },
    "retries_total": {
      "type": "integer",
      "minimum": 0
    },
    "planner_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "oracle_length": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 16
    },
    "executed_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "optimality_ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "semantic_resolver_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "semantic_unresolved_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "unseen_support_signature_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "terminal_error": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/issue_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/issue_code"
      }
    },
    "total_tokens_in": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_attended_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_tokens_out": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "final_state_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "pair_group_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "prompt_budget_violation_count": {
      "type": "integer",
      "minimum": 0
    },
    "contract_violation_count": {
      "type": "integer",
      "minimum": 0
    },
    "hash_violation_count": {
      "type": "integer",
      "minimum": 0
    },
    "base_task_id": {
      "type": "string",
      "pattern": "^bw-[0-9]{8}$"
    },
    "trajectory_policy": {
      "$ref": "common.schema.json#/$defs/trajectory_policy"
    },
    "experiment_freeze_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "episode_plan_manifest_hash": {
      "$ref": "common.schema.json#/$defs/nullable_sha256"
    },
    "plan_generation_status": {
      "$ref": "common.schema.json#/$defs/plan_generation_status"
    },
    "replay_context": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/replay_context"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_positions_consumed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 17
    },
    "plan_tokens_in_actual": {
      "type": "integer",
      "minimum": 0
    },
    "plan_tokens_out_actual": {
      "type": "integer",
      "minimum": 0
    },
    "plan_latency_ms_actual": {
      "type": "number",
      "minimum": 0
    },
    "plan_tokens_in_attributed": {
      "type": "integer",
      "minimum": 0
    },
    "plan_tokens_out_attributed": {
      "type": "integer",
      "minimum": 0
    },
    "plan_latency_ms_attributed": {
      "type": "number",
      "minimum": 0
    },
    "executor_tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "executor_tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "executor_latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "flops_actual": {
      "type": "number",
      "minimum": 0
    },
    "flops_attributed": {
      "type": "number",
      "minimum": 0
    },
    "flops_cap_per_task": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "flops_budget_exhausted": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rollout_mode": {
            "const": "RAW"
          }
        },
        "required": [
          "rollout_mode"
        ]
      },
      "then": {
        "properties": {
          "retries_total": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "PLANNER_ONLY"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "planner_seed": {
            "type": "integer",
            "enum": [
              101,
              202,
              303,
              404,
              505
            ]
          }
        }
      }
    }
  ]
}
