{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.17/experiment_freeze.schema.json",
  "title": "Confirmatory experiment freeze manifest v1.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "freeze_id",
    "stage",
    "created_at",
    "git_commit",
    "environment_lock_sha256",
    "contract_hashes",
    "model_locks",
    "checkpoint_hashes",
    "sealed_dataset_sha256",
    "sealed_dataset_commitment",
    "dataset_manifest_hashes",
    "preoutcome_certification_hashes",
    "sample_size",
    "task_manifest_sha256",
    "analysis_code_sha256",
    "compute_profile_sha256",
    "capacity_preflight_sha256",
    "approval_gate_id",
    "freeze_hash",
    "trust_topology_lock_sha256",
    "scientific_lock_sha256",
    "implementation_lock_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-freeze/1.5"
    },
    "freeze_id": {
      "type": "string",
      "pattern": "^freeze-[a-z0-9-]+$"
    },
    "stage": {
      "enum": [
        "PLANNER_CONFIRMATORY",
        "STAGE1A_CONFIRMATORY",
        "STAGE1B_CONFIRMATORY"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "propertyNames": {
        "pattern": "^(docs|locks|configs)/.+$"
      }
    },
    "model_locks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^locks/[a-zA-Z0-9._/-]+\\.json$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "checkpoint_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(checkpoints|semantic_bank)/[a-zA-Z0-9._/-]+$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "dataset_manifest_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "task_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "analysis_code_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "freeze_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "approval_gate_id": {
      "enum": [
        "G07_PLANNER_CONFIRMATORY_FREEZE",
        "G12_STAGE1A_CONFIRMATORY_FREEZE",
        "G16_STAGE1B_CONFIRMATORY_FREEZE"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "environment_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sealed_dataset_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "sealed_dataset_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_count",
        "strata_counts",
        "canonical_order_commitment_sha256"
      ],
      "properties": {
        "task_count": {
          "type": "integer",
          "minimum": 1
        },
        "strata_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "canonical_order_commitment_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "trust_topology_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "scientific_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "implementation_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "compute_profile_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "capacity_preflight_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "preoutcome_certification_hashes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sha256"
      },
      "uniqueItems": true,
      "minItems": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "PLANNER_CONFIRMATORY"
          }
        }
      },
      "then": {
        "properties": {
          "approval_gate_id": {
            "const": "G07_PLANNER_CONFIRMATORY_FREEZE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE1A_CONFIRMATORY"
          }
        }
      },
      "then": {
        "properties": {
          "approval_gate_id": {
            "const": "G12_STAGE1A_CONFIRMATORY_FREEZE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE1B_CONFIRMATORY"
          }
        }
      },
      "then": {
        "properties": {
          "approval_gate_id": {
            "const": "G16_STAGE1B_CONFIRMATORY_FREEZE"
          }
        }
      }
    }
  ]
}
