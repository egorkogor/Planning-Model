{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.14/full_plan_lineage_index.schema.json",
  "title": "Full-plan lineage index v1.14",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "compute_profile",
    "compute_profile_sha256",
    "records",
    "index_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-lineage/1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "PLANNER",
        "STAGE1B"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "arm",
          "episode_plan_manifest",
          "work_plan",
          "episode_log",
          "attempt_log",
          "semantic_signature_bank",
          "control_artifact"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^bw-[0-9]{8}$"
          },
          "arm": {
            "$ref": "common.schema.json#/$defs/arm"
          },
          "episode_plan_manifest": {
            "type": [
              "string",
              "null"
            ]
          },
          "work_plan": {
            "type": [
              "string",
              "null"
            ]
          },
          "episode_log": {
            "type": "string"
          },
          "attempt_log": {
            "type": "string"
          },
          "semantic_signature_bank": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:semantic_bank|results)/[A-Za-z0-9._/-]+\\.json$"
          },
          "control_artifact": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:controls/stage1b/shuffled-plan|semantic_bank/random-codebook)/[A-Za-z0-9._/-]+\\.json$"
          }
        }
      }
    },
    "index_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "compute_profile": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^reports/compute-profile\\.json$"
    },
    "compute_profile_sha256": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "STAGE1B"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "compute_profile": {
            "const": "reports/compute-profile.json"
          },
          "compute_profile_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    }
  ]
}
