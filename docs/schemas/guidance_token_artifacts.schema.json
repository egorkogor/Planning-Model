{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.13/guidance_token_artifacts.schema.json",
  "title": "Guidance token artifacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_revision",
    "tokenizer_hash",
    "entries",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-prompt/1.0"
    },
    "model_revision": {
      "type": "string"
    },
    "tokenizer_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "content_utf8",
          "suffix_utf8",
          "rendered_utf8",
          "token_ids",
          "attention_mask",
          "token_count",
          "entry_sha256"
        ],
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "content_utf8": {
            "type": "string"
          },
          "suffix_utf8": {
            "type": "string"
          },
          "rendered_utf8": {
            "type": "string"
          },
          "token_ids": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "attention_mask": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {
              "const": 1
            }
          },
          "token_count": {
            "const": 32
          },
          "entry_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "artifact_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
