{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.16/implementation_lock_candidate.schema.json",
  "title": "Implementation-lock candidate reviewed at G06 v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "reviewed_commit",
    "implementation_policy_sha256",
    "trust_topology_lock_sha256",
    "scientific_lock_sha256",
    "protected_files",
    "compute_profile_sha256",
    "preflight_report_sha256",
    "statistical_audit_sha256",
    "implementation_audit_sha256",
    "created_at",
    "candidate_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-implementation-candidate/1.3"
    },
    "run_id": {
      "type": "string"
    },
    "reviewed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "implementation_policy_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "scientific_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "protected_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "preflight_report_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "statistical_audit_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "candidate_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "implementation_audit_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "trust_topology_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "compute_profile_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
