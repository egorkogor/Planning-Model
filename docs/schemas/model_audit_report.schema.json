{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.19/model_audit_report.schema.json",
  "title": "Planner model audit with evidence-bound checks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "variants",
    "architecture_contract_sha256",
    "module_inventory_contract_sha256",
    "initialization_contract_sha256",
    "parameter_inventory_sha256",
    "checks",
    "status",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-model-audit/1.2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "A1",
          "A2",
          "A2b",
          "A2c",
          "A3",
          "A3r",
          "A4",
          "A5"
        ]
      }
    },
    "architecture_contract_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "module_inventory_contract_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "initialization_contract_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "parameter_inventory_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence_path",
          "evidence_sha256",
          "recomputed_value",
          "expected_value"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "PARAMETER_TOLERANCE",
              "SAME_INFORMATION",
              "RAW_ROLLOUT",
              "DORMANT_GRADIENT",
              "MODEL_ARCHITECTURE_INITIALIZATION_AND_DORMANT_PARAMETERS"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "recomputed_value": {},
          "expected_value": {}
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
