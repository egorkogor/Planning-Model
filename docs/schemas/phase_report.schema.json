{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.20/phase_report.schema.json",
  "title": "AgentPhaseReport v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "status",
    "executor_identity_sha256",
    "execution_role",
    "started_at",
    "finished_at",
    "input_hashes",
    "trust_topology_lock_status",
    "scientific_lock_status",
    "implementation_lock_status",
    "git_commit_before",
    "implementation_commit",
    "commands",
    "checks",
    "artifacts",
    "resource_usage",
    "deviations",
    "outcome",
    "next_phase",
    "operator_action_required"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-agent/1.2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^P(?:0[0-9]|1[0-9]|20)$"
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "RUNNING",
        "PASS",
        "FAIL",
        "BLOCKED",
        "WAITING_APPROVAL",
        "SKIPPED_BY_CONTRACT"
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "git_commit_before": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "implementation_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "stdout_artifact",
          "stderr_artifact"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "stdout_artifact": {
            "type": "string"
          },
          "stderr_artifact": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "schema_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_minutes",
        "estimated_cost",
        "currency"
      ],
      "properties": {
        "elapsed_minutes": {
          "type": "number",
          "minimum": 0
        },
        "cpu_peak_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "ram_peak_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "gpu_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "disk_peak_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_phase": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^P(?:0[0-9]|1[0-9]|20)$"
    },
    "operator_action_required": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_role": {
      "enum": [
        "BUILDER",
        "DATA_SEALER",
        "EVALUATION_RUNNER",
        "AUDITOR",
        "STATISTICAL_REVIEWER",
        "OPERATOR"
      ]
    },
    "executor_identity_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "trust_topology_lock_status": {
      "enum": [
        "NOT_CREATED",
        "VERIFIED",
        "MISMATCH",
        "NOT_APPLICABLE"
      ]
    },
    "scientific_lock_status": {
      "enum": [
        "NOT_CREATED",
        "VERIFIED",
        "MISMATCH",
        "NOT_APPLICABLE"
      ]
    },
    "implementation_lock_status": {
      "enum": [
        "NOT_CREATED",
        "VERIFIED",
        "MISMATCH",
        "NOT_APPLICABLE"
      ]
    }
  }
}
