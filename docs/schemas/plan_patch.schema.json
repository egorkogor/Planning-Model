{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.17/plan_patch.schema.json",
  "title": "PlanPatch v1.17",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "base_version",
    "base_plan_artifact_hash",
    "replace_from_step_index",
    "new_suffix",
    "reason_issue_id",
    "patch_hash"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "base_version": {
      "type": "integer",
      "minimum": 1
    },
    "base_plan_artifact_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "replace_from_step_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "new_suffix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {
        "$ref": "planner_step.schema.json"
      }
    },
    "reason_issue_id": {
      "type": "string",
      "minLength": 1
    },
    "patch_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
