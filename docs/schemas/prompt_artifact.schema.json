{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.21/prompt_artifact.schema.json",
  "title": "Rendered prompt tensor artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_id",
    "contract_sha256",
    "model_lock_sha256",
    "task_id",
    "state_hash",
    "goal_hash",
    "arm",
    "rendered_utf8_sha256",
    "input_ids_sha256",
    "attention_mask_sha256",
    "position_ids_sha256",
    "input_length",
    "attended_length",
    "guidance_length",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-prompt/1.0"
    },
    "prompt_id": {
      "type": "string",
      "pattern": "^prompt-[0-9a-f]{16}$"
    },
    "contract_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "model_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "task_id": {
      "type": "string",
      "pattern": "^bw-[0-9]{8}$"
    },
    "state_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "goal_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "arm": {
      "$ref": "common.schema.json#/$defs/arm"
    },
    "rendered_utf8_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "input_ids_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "attention_mask_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "position_ids_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "input_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "attended_length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "guidance_length": {
      "const": 32
    },
    "artifact_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
