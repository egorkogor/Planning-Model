{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.13/resource_usage_entry.schema.json",
  "title": "Resource usage entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase_id",
    "timestamp",
    "role",
    "elapsed_minutes",
    "cpu_percent",
    "ram_gb",
    "disk_gb",
    "estimated_cost",
    "currency"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-agent/1.2"
    },
    "run_id": {
      "type": "string"
    },
    "phase_id": {
      "pattern": "^P(?:0[0-9]|1[0-9]|20)$"
    },
    "timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "role": {
      "enum": [
        "BUILDER",
        "DATA_SEALER",
        "EVALUATION_RUNNER",
        "AUDIT_AGENT"
      ]
    },
    "elapsed_minutes": {
      "type": "number",
      "minimum": 0
    },
    "cpu_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ram_gb": {
      "type": "number",
      "minimum": 0
    },
    "gpu_utilization": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "gpu_vram_gb": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "disk_gb": {
      "type": "number",
      "minimum": 0
    },
    "estimated_cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "const": "USD"
    }
  }
}
