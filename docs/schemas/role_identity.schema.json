{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.20/role_identity.schema.json",
  "title": "Execution role identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "reviewer_type",
    "agent_provider",
    "model_family",
    "model_revision",
    "system_prompt_hash",
    "environment_identity",
    "credential_principal",
    "public_signing_key_id"
  ],
  "properties": {
    "role": {
      "enum": [
        "BUILDER",
        "DATA_SEALER",
        "EVALUATION_RUNNER",
        "AUDITOR",
        "STATISTICAL_REVIEWER"
      ]
    },
    "reviewer_type": {
      "enum": [
        "MODEL",
        "HUMAN_STATISTICIAN",
        "SERVICE_PROCESS"
      ]
    },
    "agent_provider": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "system_prompt_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "environment_identity": {
      "type": "string",
      "minLength": 1
    },
    "credential_principal": {
      "type": "string",
      "minLength": 1
    },
    "public_signing_key_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
