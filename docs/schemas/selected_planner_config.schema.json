{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.21/selected_planner_config.schema.json",
  "title": "Frozen selected Planner config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "search_contract_sha256",
    "config_id",
    "parameters",
    "selection_frozen_before_final_seeds",
    "report_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-selected-config/1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "search_contract_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "config_id": {
      "type": "string",
      "pattern": "^cfg-[0-9a-f]{16}$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_rate",
        "dropout",
        "decoder_layers",
        "encoder_layers",
        "d_model",
        "attention_heads",
        "ffn_dim",
        "batch_size_examples"
      ],
      "properties": {
        "learning_rate": {
          "enum": [
            0.0001,
            0.0003
          ]
        },
        "dropout": {
          "enum": [
            0.0,
            0.1
          ]
        },
        "decoder_layers": {
          "const": 4
        },
        "encoder_layers": {
          "const": 4
        },
        "d_model": {
          "const": 256
        },
        "attention_heads": {
          "const": 8
        },
        "ffn_dim": {
          "const": 1024
        },
        "batch_size_examples": {
          "const": 128
        }
      }
    },
    "selection_frozen_before_final_seeds": {
      "const": true
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
