{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.18/semantic_signature_bank.schema.json",
  "title": "Frozen train-only semantic signature bank v1.18",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_split", "intent_labeler_contract_sha256", "entries", "bank_hash"],
  "properties": {
    "schema_version": {"const": "work-planner-signature-bank/1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_split": {"const": "train"},
    "intent_labeler_contract_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["signature_sha256", "semantic_signature"],
        "properties": {
          "signature_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "semantic_signature": {"$ref": "semantic_signature.schema.json"}
        }
      }
    },
    "bank_hash": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
