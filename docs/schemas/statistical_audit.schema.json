{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-brain.local/schemas/work-planner/v1.16/statistical_audit.schema.json",
  "title": "Independent statistical implementation audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "reviewer",
    "builder_identity_sha256",
    "reviewer_independence",
    "reviewed_commit",
    "reviewed_artifacts",
    "checks",
    "decision",
    "limitations",
    "created_at",
    "report_hash",
    "signature_algorithm",
    "public_key_id",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "work-planner-stat-audit/1.1"
    },
    "run_id": {
      "type": "string"
    },
    "reviewer": {
      "allOf": [
        {
          "$ref": "role_identity.schema.json"
        },
        {
          "properties": {
            "role": {
              "const": "STATISTICAL_REVIEWER"
            }
          }
        }
      ]
    },
    "builder_identity_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "reviewer_independence": {
      "enum": [
        "DIFFERENT_MODEL_FAMILY",
        "HUMAN_STATISTICIAN"
      ]
    },
    "reviewed_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "status",
          "evidence_sha256"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "HIERARCHICAL_BOOTSTRAP",
              "CLUSTERED_STAGE1A_BOOTSTRAP",
              "PAIRED_STAGE1B_BOOTSTRAP",
              "NONINFERIORITY_AND_DIRECTION_GATES",
              "SAMPLE_SIZE_POWER",
              "TIE_BREAK_AND_MISSING_PAIRS",
              "DECISION_GATE_RECOMPUTATION"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      },
      "maxItems": 7,
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "report_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "signature_algorithm": {
      "const": "ed25519"
    },
    "public_key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "allOf": [
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "HIERARCHICAL_BOOTSTRAP"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "CLUSTERED_STAGE1A_BOOTSTRAP"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "PAIRED_STAGE1B_BOOTSTRAP"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "NONINFERIORITY_AND_DIRECTION_GATES"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "SAMPLE_SIZE_POWER"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "TIE_BREAK_AND_MISSING_PAIRS"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "check_id": {
                "const": "DECISION_GATE_RECOMPUTATION"
              }
            },
            "required": [
              "check_id"
            ]
          }
        }
      }
    }
  ]
}
