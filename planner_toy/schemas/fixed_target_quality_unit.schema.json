{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planning-model.local/schemas/fixed_target_quality_unit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_evidence_version", "attempt_identity_sha256", "scientific_parent_implementation_commit", "execution_implementation_commit", "execution_context", "variant", "seed", "dataset_hash", "ordered_train_task_ids", "ordered_eval_task_ids", "epochs", "updates", "training_execution_mode", "optimizer", "runtime_contract_sha256", "target_observation_sha256", "source_inventory_sha256", "observation", "checkpoint_manifest_sha256", "task_results_sha256", "unit_manifest_sha256"],
  "properties": {
    "unit_evidence_version": {"const": "toy-quality-fixed-target-sharded-unit/1.0"},
    "attempt_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scientific_parent_implementation_commit": {"const": "779172c3bbca3d03552deaed6421e82fcf19a932"},
    "execution_implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "execution_context": {"enum": ["formal-fixed-target", "qualification-only"]},
    "variant": {"enum": ["A2", "A3", "A4"]},
    "seed": {"enum": [17, 29, 43]},
    "dataset_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ordered_train_task_ids": {"const": ["bw-00000001", "bw-00000002", "bw-00000003"]},
    "ordered_eval_task_ids": {"const": ["bw-00000004", "bw-00000005"]},
    "epochs": {"const": 3}, "updates": {"const": 9},
    "training_execution_mode": {"const": "TRAINED_IN_ATTEMPT_SHARDED"},
    "optimizer": {
      "type": "object", "additionalProperties": false,
      "required": ["class", "learning_rate", "betas", "eps", "weight_decay", "gradient_clip_norm", "observed_foreach", "observed_fused"],
      "properties": {
        "class": {"const": "AdamW"}, "learning_rate": {"const": 0.0003},
        "betas": {"const": [0.9, 0.95]}, "eps": {"const": 1e-8},
        "weight_decay": {"const": 0.01}, "gradient_clip_norm": {"const": 1.0},
        "observed_foreach": {"const": false}, "observed_fused": {"const": false}
      }
    },
    "runtime_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_observation_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_inventory_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation": {"type": "object"},
    "checkpoint_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "task_results_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "unit_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
