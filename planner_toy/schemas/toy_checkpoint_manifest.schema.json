{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "config_path": {
      "const": "development-config.json"
    },
    "confirmatory": {
      "const": false
    },
    "initialization_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "inventory_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "model_file_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "model_path": {
      "pattern": "^model/trained\\.pt$",
      "type": "string"
    },
    "runtime": {
      "type": "object"
    },
    "schema_version": {
      "const": "toy-checkpoint-manifest/1.0"
    },
    "sealed_data": {
      "const": false
    },
    "state_dict_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "training_report_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "training_report_path": {
      "const": "model/training-report.json"
    }
  },
  "required": [
    "schema_version",
    "model_path",
    "model_file_sha256",
    "state_dict_sha256",
    "config_path",
    "config_hash",
    "inventory_sha256",
    "initialization_sha256",
    "training_report_path",
    "training_report_hash",
    "runtime",
    "confirmatory",
    "sealed_data"
  ],
  "title": "toy-checkpoint-manifest/1.0",
  "type": "object"
}
