{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arm": {
      "const": "PLANNER_A2_RAW"
    },
    "attempts_total": {
      "minimum": 0,
      "type": "integer"
    },
    "canonical_task_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_file_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "episode_plan_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "executed_length": {
      "minimum": 0,
      "type": "integer"
    },
    "final_state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "goal_success": {
      "type": "boolean"
    },
    "plan_generation_status": {
      "enum": [
        "READY",
        "FAILED"
      ]
    },
    "plan_positions_consumed": {
      "minimum": 0,
      "type": "integer"
    },
    "planner_calls": {
      "const": 1
    },
    "planner_request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "toy-episode-log/1.0"
    },
    "seed": {
      "const": 17
    },
    "split": {
      "const": "development"
    },
    "stage": {
      "const": "PLANNER_ONLY"
    },
    "task_id": {
      "type": "string"
    },
    "terminal_error": {
      "enum": [
        "PLAN_NO_END",
        "PLAN_PARSE_ERROR",
        "PLAN_UNKNOWN_REF",
        "PLAN_GENERATION_ERROR",
        "EXECUTOR_PRECONDITION_FAILED",
        "GOAL_NOT_ACHIEVED",
        null
      ]
    },
    "variant": {
      "enum": [
        "A2",
        "A3",
        "A4"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "canonical_task_hash",
    "config_hash",
    "checkpoint_manifest_hash",
    "checkpoint_file_hash",
    "episode_plan_manifest_hash",
    "seed",
    "split",
    "stage",
    "arm",
    "planner_calls",
    "attempts_total",
    "executed_length",
    "plan_positions_consumed",
    "final_state_hash",
    "goal_success",
    "plan_generation_status",
    "terminal_error",
    "planner_request_hash",
    "variant"
  ],
  "title": "toy-episode-log/1.0",
  "type": "object"
}
