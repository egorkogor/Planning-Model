  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "canonical_task_hash",
    "config_hash",
    "checkpoint_manifest_hash",
    "seed",
    "split",
    "stage",
    "arm",
    "confirmatory",
    "sealed_data",
    "request_hash",
    "checkpoint_file_hash"
